
import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        String s=sc.nextLine();
        char c=' ';
        char x=' ';
        for(int i=0;i<s.length();i++){
           c=s.charAt(i);
    }
    for(int i=s.length()-1;i>=0;i--){
         x=s.charAt(i);
         System.out.print(x);
    }
    System.out.println();

    if(c==x)
        System.out.println("palindrome");
    else
        System.out.print("Not palindrome");
}
}
