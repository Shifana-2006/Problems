import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        String s=sc.nextLine();
        for(int i=0;i<s.length();i++){
            char c=s.charAt(i);
         if(c>='a'&c<='z'){
             c=(char)(c-32);
         }
         else{
             c=(char)(c+32);
         }
         System.out.print(c);
        }
}
}
